    },
    "expanded": {
      "blur": "32px",
      "saturation": "140%",
      "fillAlpha": 0.2,
      "rimAlpha": 0.26,
      "shadowAlpha": 0.23,
      "use": "More popover only"
    }
  },
  "radiusTokens": {
    "reading": "26px",
    "control": "16px",
    "icon": "14px",
    "popover": "22px",
    "capsule": "999px"
